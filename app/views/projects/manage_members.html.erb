<h1>Manage Members for <%= @project.name %></h1>

<div class="card mb-4">
  <div class="card-header">Add New Member</div>
  <div class="card-body">
    <%= form_with url: add_member_project_path(@project), method: :post, class: "row g-3" do |f| %>
      <div class="col-md-6">
        <%= f.label :email, "User Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true, placeholder: "Enter user email" %>
      </div>
      <div class="col-md-4">
        <%= f.label :role, "Role", class: "form-label" %>
        <%= f.select :role, [["Member", "member"], ["Admin", "admin"]], {}, class: "form-select" %>
      </div>
      <div class="col-md-2 d-grid">
        <%= f.submit "Add Member", class: "btn btn-primary mt-4" %>
      </div>
    <% end %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <!-- Project creator is always an admin but not in the memberships table -->
      <tr>
        <td><%= @project.user.name %></td>
        <td><%= @project.user.email %></td>
        <td><span class="badge bg-primary">Creator (Admin)</span></td>
        <td class="text-center">
          <span class="text-muted">Project Creator</span>
        </td>
      </tr>
      
      <% @project_memberships.each do |membership| %>
        <tr>
          <td><%= membership.user.name %></td>
          <td><%= membership.user.email %></td>
          <td>
            <% if membership.admin? %>
              <span class="badge bg-primary">Admin</span>
            <% else %>
              <span class="badge bg-secondary">Member</span>
            <% end %>
          </td>
          <td>
            <div class="d-flex gap-2 justify-content-center">
              <%= form_with url: update_member_project_path(@project), method: :patch, class: 'd-inline' do |f| %>
                <%= f.hidden_field :membership_id, value: membership.id %>
                <% if membership.admin? %>
                  <%= f.hidden_field :role, value: 'member' %>
                  <%= f.submit 'Demote to Member', class: 'btn btn-sm btn-outline-warning' %>
                <% else %>
                  <%= f.hidden_field :role, value: 'admin' %>
                  <%= f.submit 'Promote to Admin', class: 'btn btn-sm btn-outline-success' %>
                <% end %>
              <% end %>
              
              <%= button_to remove_member_project_path(@project, membership_id: membership.id), 
                  method: :delete, 
                  class: 'btn btn-sm btn-outline-danger',
                  data: { confirm: 'Are you sure you want to remove this member?' } do %>
                Remove
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-3">
  <%= link_to 'Back to Project', @project, class: 'btn btn-secondary' %>
</div>