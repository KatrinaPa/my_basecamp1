<div class="container py-4">
  <div class="card shadow-sm mb-4">
    <div class="card-header border-0" style="background-color: var(--bs-danger-bg-subtle);">
      <h5 class="card-title mb-0">Add New Member</h5>
    </div>
    <div class="card-body">
      <%= form_with(url: add_member_project_path(@project), method: :post, class: "row g-2") do |f| %>
        <div class="col-md-6 col-lg-7">
          <%= f.email_field :email, class: "form-control", placeholder: "Enter member's email" %>
        </div>
        <div class="col-md-3 col-lg-3">
          <%= f.select :role, 
              [["Member", "member"], ["Admin", "admin"]], 
              {}, 
              class: "form-select" %>
        </div>
        <div class="col-md-3 col-lg-2">
          <%= f.submit "Add Member", 
              class: "btn w-100", 
              style: "background-color: var(--bs-danger-bg-subtle); padding: 0.5rem 1rem;" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-header border-0" style="background-color: var(--bs-success-bg-subtle);">
      <h5 class="mb-0">Project Members</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Role</th>
            <th>Manage Role</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <!-- Creator Row -->
          <tr>
            <td><%= @project.user.email %></td>
            <td><%= @project.user.name %></td>
            <td>
              <span class="badge p-2 fw-normal" style="background-color: var(--bs-success-bg-subtle); color: #212529;">
                Creator
              </span>
            </td>
            <td>-</td>
            <td>-</td>
          </tr>

          <!-- Members Rows -->
          <% @project.project_memberships.includes(:user).each do |membership| %>
            <tr>
              <td><%= membership.user.email %></td>
              <td><%= membership.user.name %></td>
              <td>
                <span class="badge p-2 fw-normal" style="background-color: #dee2e6; color: #212529;">
                  <%= membership.admin? ? 'Admin' : 'Member' %>
                </span>
              </td>
              <td>
                <%= button_to update_member_project_path(@project, user_id: membership.user.id),
                    method: :patch,
                    class: "badge border-0 p-2 fw-normal",
                    style: "background-color: #dee2e6; color: #212529; transition: all 0.3s;",
                    onmouseover: "this.style.backgroundColor='#6c757d'; this.style.color='white'",
                    onmouseout: "this.style.backgroundColor='#dee2e6'; this.style.color='#212529'" do %>
                  <%= membership.admin? ? 'Demote to Member' : 'Promote to Admin' %>
                <% end %>
              </td>
              <td class="text-center">
                <%= button_to remove_member_project_path(@project, user_id: membership.user.id),
                    method: :delete,
                    data: { confirm: "Are you sure you want to remove this member?" },
                    class: "btn btn-sm btn-outline-secondary",
                    style: "transition: all 0.3s;",
                    onmouseover: "this.style.backgroundColor='#6c757d'; this.style.color='white'",
                    onmouseout: "this.style.backgroundColor=''; this.style.color=''" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to @project, class: "btn btn-outline-secondary btn-sm" do %>
      <i class="bi bi-arrow-left"></i> Back to project
    <% end %>
  </div>
</div>