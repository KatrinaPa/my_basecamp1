<br/>
<div class="jumbotron p-5 rounded" style="background-color: var(--bs-success-bg-subtle);">
  <p class="fs-2 fw-light"><%= @project.name %></p>
  <div class="bg-white p-3 rounded shadow-sm">
    <p class="lead mb-0"><%= @project.description %></p>
  </div>
  
  <!-- Add Project Members section -->
  <div class="bg-white p-3 rounded shadow-sm mt-3">
    <h5 class="mb-3">Project Members</h5>
    <div class="d-flex flex-wrap gap-2">
      <div class="badge bg-primary p-2">
        <%= @project.user.name || @project.user.email %> (Creator)
      </div>
      <% @project.project_memberships.includes(:user).each do |membership| %>
        <div class="badge <%= membership.admin? ? 'bg-info' : 'bg-secondary' %> p-2">
          <%= membership.user.name || membership.user.email %>
          <% if membership.admin? %> (Admin)<% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Project Tools Section -->
<div class="mt-4">
  <!-- Project Tools Navigation -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">Project Tools</h5>
    </div>
    <div class="card-body">
      <div class="d-flex flex-wrap gap-3">
        <a href="<%= project_task_lists_path(@project) %>" class="text-decoration-none">
          <div class="text-center p-3 border rounded hover-lift" style="min-width: 120px; transition: all 0.2s;">
            <i class="bi bi-list-check text-primary display-6"></i>
            <div class="mt-2">To-Dos</div>
          </div>
        </a>
        
        <!-- Placeholder for future tools -->
        <div class="text-center p-3 border rounded text-muted" style="min-width: 120px; opacity: 0.5;">
          <i class="bi bi-calendar3 display-6"></i>
          <div class="mt-2">Schedule</div>
          <small>(Coming Soon)</small>
        </div>
        
        <div class="text-center p-3 border rounded text-muted" style="min-width: 120px; opacity: 0.5;">
          <i class="bi bi-chat-dots display-6"></i>
          <div class="mt-2">Message Board</div>
          <small>(Coming Soon)</small>
        </div>
        
        <div class="text-center p-3 border rounded text-muted" style="min-width: 120px; opacity: 0.5;">
          <i class="bi bi-folder display-6"></i>
          <div class="mt-2">Files</div>
          <small>(Coming Soon)</small>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Task Lists Summary -->
  <div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Recent To-Dos</h5>
      <a href="<%= project_task_lists_path(@project) %>" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body">
      <% task_lists = @project.task_lists.order(created_at: :desc).limit(3) %>
      
      <% if task_lists.empty? %>
        <div class="text-center py-4 text-muted">
          <i class="bi bi-list-check display-5"></i>
          <h5 class="mt-3">No task lists yet</h5>
          <p>Keep your project organized by creating to-do lists</p>
          <% if @project.admin?(current_user) %>
            <a href="<%= new_project_task_list_path(@project) %>" class="btn btn-primary mt-2">
              <i class="bi bi-plus-circle me-1"></i> Create First To-Do List
            </a>
          <% end %>
        </div>
      <% else %>
        <div class="list-group">
          <% task_lists.each do |task_list| %>
            <a href="<%= project_task_list_path(@project, task_list) %>" class="list-group-item list-group-item-action">
              <div class="d-flex w-100 justify-content-between align-items-center">
                <h6 class="mb-1"><%= task_list.title %></h6>
                <span class="badge <%= task_list.completion_percentage == 100 ? 'bg-success' : 'bg-primary' %>">
                  <%= task_list.completion_percentage %>%
                </span>
              </div>
              <div class="progress mt-2" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: <%= task_list.completion_percentage %>%;" 
                    aria-valuenow="<%= task_list.completion_percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <small class="text-muted">
                <%= task_list.tasks.where(completed: true).count %> of <%= task_list.tasks.count %> tasks complete
              </small>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<br/>
    
<div class="d-flex gap-2">
  <% if @project.admin?(current_user) %>
    <%= link_to "Manage Members", manage_members_project_path(@project), class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "Edit", edit_project_path(@project), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", @project, method: :delete, data: { confirm: "Are you sure you want to delete this project?" }, class: "btn btn-outline-danger btn-sm" %>
  <% end %>
  
  <%= link_to "Back to projects", projects_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<style>
  .hover-lift:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }
</style>