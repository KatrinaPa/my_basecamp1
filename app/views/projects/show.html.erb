<br/>
<div class="jumbotron p-5 rounded" style="background-color: var(--bs-success-bg-subtle);">
  <p class="fs-2 fw-light"><%= @project.name %></p>
  <div class="bg-white p-3 rounded shadow-sm">
    <p class="lead mb-0"><%= @project.description %></p>
  </div>
  
  <!-- Add Project Members section -->
  <div class="bg-white p-3 rounded shadow-sm mt-3">
    <h5 class="mb-3">Project Members</h5>
    <div class="d-flex flex-wrap gap-2">
      <div class="badge bg-primary p-2">
        <%= @project.user.name || @project.user.email %> (Creator)
      </div>
      <% @project.project_memberships.includes(:user).each do |membership| %>
        <div class="badge <%= membership.admin? ? 'bg-info' : 'bg-secondary' %> p-2">
          <%= membership.user.name || membership.user.email %>
          <% if membership.admin? %> (Admin)<% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<br/>
    
<div class="d-flex gap-2">
  <% if @project.admin?(current_user) %>
    <%= link_to "Manage Members", manage_members_project_path(@project), class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "Edit", edit_project_path(@project), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", @project, method: :delete, data: { confirm: "Are you sure you want to delete this project?" }, class: "btn btn-outline-danger btn-sm" %>
  <% end %>
  
  <%= link_to "Back to projects", projects_path, class: "btn btn-outline-secondary btn-sm" %>
</div>