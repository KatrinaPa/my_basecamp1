<div class="container py-4">
  <!-- Navigation Buttons -->
  <div class="d-flex justify-content-between align-items-center mb-5">
    <div class="d-flex flex-wrap gap-2">
      <a href="#created-projects" 
         class="btn border-0 nav-btn text-white" 
         style="background-color: #6c757d; transition: all 0.3s;">
        <i class="bi bi-person-workspace me-2"></i>My Projects
      </a>
      
      <a href="#joined-projects" 
         class="btn border-0 nav-btn text-white" 
         style="background-color: #6c757d; transition: all 0.3s;">
        <i class="bi bi-people-fill me-2"></i>Projects I Participate In
      </a>
    </div>

    <%= link_to new_project_path, 
        class: "btn border-0", 
        style: "background-color: var(--bs-danger-bg-subtle); transition: all 0.3s;" do %>
      <i class="bi bi-plus-circle me-2"></i>New Project
    <% end %>
  </div>

  <!-- Projects Created by Me -->
  <div class="mb-5" id="created-projects">
    <h2 class="h4 mb-4">
      <i class="bi bi-person-workspace text-success me-2"></i>
      Projects Created by Me
    </h2>
    
    <div class="row g-4">
      <% @projects.where(user: current_user).each do |project| %>
        <%= render 'project_card', project: project %>
      <% end %>
    </div>
  </div>

  <!-- Projects I've Joined -->
  <div id="joined-projects">
    <h2 class="h4 mb-4">
      <i class="bi bi-people-fill text-success me-2"></i>
      Projects I've Joined
    </h2>
    
    <div class="row g-4">
      <% @projects.where.not(user: current_user).each do |project| %>
        <%= render 'project_card', project: project %>
      <% end %>
    </div>
  </div>

  <!-- Empty State -->
  <% if @projects.empty? %>
    <div class="text-center py-5">
      <div class="card bg-light shadow-sm border-0 p-4 mt-5">
        <div class="text-muted">
          <i class="bi bi-folder-plus display-3"></i>
          <h3 class="mt-3">No Projects Found</h3>
          <p>Start by creating your first project!</p>
          <%= link_to new_project_path, class: "btn btn-lg", style: "background-color: var(--bs-danger-bg-subtle);" do %>
            <i class="bi bi-plus-circle me-2"></i>Create Project
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
  
  /* Remove the general btn hover style */
  .btn:hover {
    background-color: var(--bs-danger) !important;
    color: white !important;
  }

  /* Update navigation button hover styles */
  .nav-btn:hover {
    background-color: var(--bs-success-bg-subtle) !important;
    color: #212529 !important;
  }

  html {
    scroll-behavior: smooth;
  }
</style>