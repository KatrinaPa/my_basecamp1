<div class="container py-4">
  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6 mb-0"><%= current_user&.admin? ? "All Projects" : "My Projects" %></h1>
    <%= link_to new_project_path, class: "btn btn-lg border-0", style: "background-color: var(--bs-danger-bg-subtle); transition: all 0.3s;" do %>
      <i class="bi bi-plus-circle me-2"></i>New Project
    <% end %>
  </div>

    <!-- Projects Grid -->
    <div class="row g-4">
      <% @projects.each do |project| %>
        <div class="col-sm-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0 hover-shadow" style="transition: all 0.3s ease">
            <!-- Card Header -->
            <div class="card-header border-0 py-3" style="background-color: var(--bs-success-bg-subtle);">
              <h5 class="card-title text-truncate mb-0" title="<%= project.name %>">
                <%= project.name %>
              </h5>
              <% if current_user&.admin? %>
                <small class="text-muted">
                  Owner: <%= project.user&.name || 'No owner' %>
                </small>
              <% end %>
            </div>
            
            <!-- Card Body -->
            <div class="card-body">
              <div class="text-muted small mb-2">
                <i class="bi bi-calendar-event me-1"></i>
                Created <%= time_ago_in_words(project.created_at) %> ago
              </div>
              <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                <%= project.description %>
              </p>
            </div>

            <!-- Card Footer -->
            <div class="card-footer bg-light border-0">
              <div class="d-flex gap-2 justify-content-end">
                <%= link_to project, class: "btn btn-outline-secondary btn-sm", title: "View Details" do %>
                  <i class="bi bi-eye"></i>
                <% end %>
                <% if current_user&.admin? || project.user == current_user %>
                  <%= link_to edit_project_path(project), class: "btn btn-outline-secondary btn-sm", title: "Edit Project" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to project, method: :delete, class: "btn btn-outline-danger btn-sm", 
                      data: { confirm: "Are you sure you want to delete this project?" }, title: "Delete Project" do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Empty State -->
      <% if @projects.empty? %>
        <div class="col-12 text-center py-5">
          <div class="card bg-light shadow-sm border-0 p-4 mt-5">
            <div class="text-muted">
              <i class="bi bi-folder-plus display-3"></i>
              <h3 class="mt-3">No Projects Found</h3>
              <p>Start by creating your first project!</p>
              <%= link_to new_project_path, class: "btn btn-lg", style: "background-color: var(--bs-danger-bg-subtle);" do %>
                <i class="bi bi-plus-circle me-2"></i>Create Project
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
  
  .btn:hover {
    background-color: var(--bs-danger) !important;
    color: white !important;
  }
</style>