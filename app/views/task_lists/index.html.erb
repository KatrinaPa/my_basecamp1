<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 mb-0"><%= @project.name %> - Task Lists</h1>
      <p class="text-muted">Manage your project tasks</p>
    </div>
    
    <div class="d-flex gap-2">
      <% if @project.admin?(current_user) %>
        <%= link_to new_project_task_list_path(@project), class: "btn btn-primary" do %>
          <i class="bi bi-plus-circle me-1"></i> New Task List
        <% end %>
      <% end %>
      <%= link_to @project, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Project
      <% end %>
    </div>
  </div>
  
  <% if @task_lists.empty? %>
    <div class="card shadow-sm">
      <div class="card-body text-center py-5">
        <i class="bi bi-list-check display-4 text-muted"></i>
        <h3 class="mt-3">No Task Lists</h3>
        <p class="text-muted">Get started by creating your first task list for this project.</p>
        <% if @project.admin?(current_user) %>
          <%= link_to new_project_task_list_path(@project), class: "btn btn-primary mt-2" do %>
            <i class="bi bi-plus-circle me-1"></i> Create Task List
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="row g-4">
      <% @task_lists.each do |task_list| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm hover-shadow" style="transition: all 0.3s ease;">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
              <h5 class="card-title mb-0"><%= task_list.title %></h5>
              <span class="badge <%= task_list.completion_percentage == 100 ? 'bg-success' : 'bg-primary' %>">
                <%= task_list.completion_percentage %>%
              </span>
            </div>
            <div class="card-body">
              <% if task_list.description.present? %>
                <p class="card-text text-muted small mb-3"><%= task_list.description %></p>
              <% end %>
              
              <div class="progress mb-3" style="height: 8px;">
                <div class="progress-bar" role="progressbar" style="width: <%= task_list.completion_percentage %>%;" 
                     aria-valuenow="<%= task_list.completion_percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              
              <p class="small text-muted mb-0">
                <% task_count = task_list.tasks.count %>
                <% completed_count = task_list.tasks.where(completed: true).count %>
                <%= completed_count %> of <%= task_count %> tasks completed
              </p>
            </div>
            <div class="card-footer bg-transparent d-flex justify-content-end gap-2">
              <%= link_to project_task_list_path(@project, task_list), class: "btn btn-sm btn-outline-primary" do %>
                <i class="bi bi-eye me-1"></i> View Tasks
              <% end %>
              
              <% if @project.admin?(current_user) %>
                <%= link_to edit_project_task_list_path(@project, task_list), class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="bi bi-pencil me-1"></i> Edit
                <% end %>
                
                <%= button_to project_task_list_path(@project, task_list), method: :delete, 
                    data: { confirm: "Are you sure you want to delete this task list and all its tasks?" }, 
                    class: "btn btn-sm btn-outline-danger" do %>
                  <i class="bi bi-trash me-1"></i> Delete
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
</style>