<!-- app/views/task_lists/new.html.erb -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-9">
      <div class="card shadow-sm border-0">
        <div class="card-header border-0" style="background-color: var(--bs-success-bg-subtle);">
          <h2 class="card-title mb-0">New Task List</h2>
        </div>

        <div class="card-body">
          <%= form_with(model: [@project, @task_list], local: true) do |f| %>
            <div class="mb-3">
              <%= f.label :title, class: "form-label" %>
              <%= f.text_field :title, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, class: "form-label" %>
              <%= f.text_area :description, class: "form-control", rows: 4 %>
            </div>

            <div class="actions d-flex gap-2">
              <%= f.submit "Create Task list", 
                  class: "btn",
                  style: "background-color: var(--bs-success-bg-subtle);" %>
              <%= link_to "Back to task lists", 
                  project_task_lists_path(@project), 
                  class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>