<!-- app/views/task_lists/show.html.erb -->
<div class="container py-4">
  <!-- Header Section -->
  <div class="mb-4">
    <h1 class="h2 mb-2"><%= @task_list.title %></h1>
    <p class="text-muted mb-3"><%= @project.name %></p>
    
    <!-- Action Buttons and Completion Badge -->
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex gap-2">
        <% if @project.admin?(current_user) %>
          <%= link_to edit_project_task_list_path(@project, @task_list), 
              class: "btn btn-outline-secondary btn-sm",
              style: "transition: all 0.3s;",
              onmouseover: "this.style.backgroundColor='#6c757d'; this.style.color='white'",
              onmouseout: "this.style.backgroundColor=''; this.style.color=''" do %>
            <i class="bi bi-pencil"></i> Edit List
          <% end %>
        <% end %>
        <%= link_to project_task_lists_path(@project), 
            class: "btn btn-outline-secondary btn-sm",
            style: "transition: all 0.3s;",
            onmouseover: "this.style.backgroundColor='#6c757d'; this.style.color='white'",
            onmouseout: "this.style.backgroundColor=''; this.style.color=''" do %>
          <i class="bi bi-arrow-left"></i> Back to Lists
        <% end %>
      </div>

      <span class="badge p-2" style="background-color: var(--bs-success-bg-subtle); color: var(--bs-success);">
        <%= @task_list.completion_percentage %>% Complete
      </span>
    </div>
  </div>
  
  <% if @task_list.description.present? %>
    <div class="card mb-4 shadow-sm">
      <div class="card-body">
        <h5 class="card-title">Description</h5>
        <p class="card-text"><%= @task_list.description %></p>
      </div>
    </div>
  <% end %>
  
  <!-- Progress bar -->
  <div class="progress mb-4" style="height: 10px;">
    <div class="progress-bar bg-success" role="progressbar" 
         style="width: <%= @task_list.completion_percentage %>%;" 
         aria-valuenow="<%= @task_list.completion_percentage %>" 
         aria-valuemin="0" aria-valuemax="100"></div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
      <h5 class="mb-0">Tasks</h5>
    </div>
    
    <ul class="list-group list-group-flush">
      <% if @tasks.empty? %>
        <li class="list-group-item text-center py-5 text-muted">
          <i class="bi bi-check2-square display-5"></i>
          <h4 class="mt-3">No tasks yet</h4>
          <p>Add your first task to get started!</p>
        </li>
      <% else %>
        <% @tasks.each do |task| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <%= button_to toggle_project_task_list_task_path(@project, @task_list, task), 
                          method: :patch, 
                          class: "btn btn-sm me-2 #{task.completed ? 'text-success' : 'text-muted'}" do %>
                <i class="bi <%= task.completed ? 'bi-check-circle-fill' : 'bi-circle' %> fs-5"></i>
              <% end %>
              
              <span class="<%= task.completed ? 'text-decoration-line-through text-muted' : '' %>">
                <%= task.title %>
              </span>
            </div>
            
            <div class="d-flex align-items-center">
              <% if @project.admin?(current_user) %>
                <%= button_to project_task_list_task_path(@project, @task_list, task), 
                            method: :delete, 
                            data: { confirm: "Are you sure you want to delete this task?" }, 
                            class: "btn btn-sm text-danger" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ul>
    
    <div class="card-body border-top">
      <%= form_with(model: [@project, @task_list, @task], local: true, class: "d-flex") do |f| %>
        <%= f.text_field :title, class: "form-control me-2", placeholder: "Add a new task...", required: true %>
        <%= f.submit "Add Task", 
            class: "btn",
            style: "background-color: var(--bs-danger-bg-subtle);" %>
      <% end %>
    </div>
  </div>
</div>