<h2>Edit Profile<% resource_name.to_s.humanize %></h2>
<div class="container">
  <div class="jumbotron p-5 rounded" style="background-color: var(--bs-success-bg-subtle);">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="fiel form-group">
        <%= f.label :email %><br />
        <%= f.email_field :email, class:"form-control", placeholder:"Email", autofocus: true, autocomplete: "email" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field form-group">
        <%= f.label :password %> <i>(leave blank if you don't want to change it)</i><br />
        <%= f.password_field :password, class:"form-control", autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <em><%= @minimum_password_length %> characters minimum</em>
        <% end %>
      </div>
      <br/>

      <div class="field form-group">
        <%= f.label :password_confirmation %><br />
        <%= f.password_field :password_confirmation, class:"form-control", autocomplete: "new-password" %>
      </div>

      <div class="field form-group">
        <%= f.label :current_password %><br />
        <%= f.password_field :current_password, class:"form-control", placeholder:"we need your current password to confirm your changes)", autocomplete: "current-password" %>
      </div>

      <br/>

      <div class="actions">
        <%= f.submit "Update", class: "btn border border-white text-white", 
            style: "background-color: var(--bs-secondary); transition: background-color 0.3s ease-in-out;", 
            onmouseover: "this.style.backgroundColor='#343a40'", 
            onmouseout: "this.style.backgroundColor='var(--bs-secondary)'" %>
      </div>
    <% end %>
  </div>
  <div class="text-left">
    <%= link_to "Back", :back, class: "btn btn-light btn-sm mt-3" %>
  </div>
</div>

<div class="jumbotron bg-light p-3 rounded" style="width: 50%; margin: 0 auto;">
  <div class="card w-100">
      <div class="card-body">
        <h5 class="card-title">Cancel my account</h5>
        <p class="card-text">Are you unhappy with us?</p>
        <%= button_to "Delete account", registration_path(resource_name), 
          data: { confirm: "Are you sure?" }, 
          method: :delete, 
          class: "btn btn-outline-danger" %>
      </div>
    </div>
  </div>
</div>
