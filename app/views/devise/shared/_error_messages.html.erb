<% if resource.errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <% if resource.errors.count == 1 %>
      <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>There was a problem with your submission</h5>
    <% else %>
      <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>There were <%= resource.errors.count %> problems with your submission</h5>
    <% end %>
    
    <hr>
    
    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
    
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>