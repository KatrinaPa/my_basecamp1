<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-xl-7">
      <div class="card shadow-sm border-0">
        <div class="card-header border-0" style="background-color: var(--bs-danger-bg-subtle);">
          <h2 class="card-title h4 mb-0">Log in</h2>
        </div>

        <div class="card-body">
          <div class="jumbotron p-3 text-secondary-emphasis bg-secondary-subtle border border-secondary-subtle rounded-3">
            <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
              <% if flash[:alert] %>
                <div class="alert alert-danger">
                  <%= flash[:alert] %>
                </div>
              <% end %>

              <div class="field form-group">
                <%= f.label :email %><br />
                <%= f.email_field :email, class:"form-control", placeholder:"Email", autofocus: true, autocomplete: "email" %>
              </div>
              <br/>

              <div class="field form-group">
                <%= f.label :password %><br />
                <%= f.password_field :password, class:"form-control", placeholder:"Password", autocomplete: "current-password" %>
              </div>

              <% if devise_mapping.rememberable? %>
                <div class="field form-group">
                  <%= f.check_box :remember_me, class: "form-check-input" %>
                  <%= f.label :remember_me %>
                </div>
              <% end %>

              <div class="actions">
                <%= f.submit "Log in", class:"btn btn-dark border border-white mt-4" %>
                <% f.submit "Log in", class:"btn border border-white", style:"background-color: var(--bs-danger-bg-subtle);" %>
              </div>
            <% end %>
          </div>

          <div class="d-flex justify-content-end mt-4">
            <div class="btn-group" role="group">
              <%= link_to "Sign up", new_registration_path(resource_name), class: "btn border border-white", style: "background-color: var(--bs-success-bg-subtle);" %>
              <%= link_to "Forgot your password?", new_password_path(resource_name), class: "btn border border-white", style: "background-color: var(--bs-success-bg-subtle);" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
