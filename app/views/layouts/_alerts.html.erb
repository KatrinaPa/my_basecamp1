<div class="alert alert-secondary alert-dismissible fade show py-1 small" role="alert" style="max-width: 800px; margin: 0.5rem auto;">
  <div class="d-flex align-items-center gap-2" style="min-height: 24px;">
    <i class="bi bi-info-circle"></i>
    <span><%= notice %></span>
    <button type="button" class="btn-close ms-auto" 
            style="padding: 0.25rem; transform: scale(0.7); margin-right: 1rem; margin-top: 0.3rem;" 
            data-bs-dismiss="alert" 
            aria-label="Close">
    </button>
  </div>
</div>