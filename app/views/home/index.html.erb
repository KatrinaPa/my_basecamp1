<div class="container d-flex justify-content-center pt-5">
  <div class="card shadow-lg border-0" style="max-width: 35rem;">
    <div class="card-body p-4">
      <div class="text-center">
        <%= image_tag "logo3.png", class: "card-img-top", alt: "CollabHub Logo", style: "max-width: 200px; display: block; margin: 0 auto;" %>
      </div>
      
      <div class="text-center mt-4">
        <h2 class="card-title">Welcome to My Basecamp</h2>
        <p class="lead text-secondary mb-4">
          Manage your projects efficiently and<br>
          collaborate with your team.
        </p>
      </div>

      <div class="bg-light rounded-4 p-4 mb-4">
        <h2 class="h5 fw-bold mb-3">About Our Platform</h2>
        <p class="text-secondary mb-2">
          We're dedicated to making project management simple and effective. 
          Our platform helps teams stay organized, meet deadlines, and achieve their goals.
        </p>
        <p class="text-secondary mb-0">
          Whether you're managing a small team or a large organization, 
          Basecamp provides the tools you need to succeed.
        </p>
      </div>

      <div class="text-center">
        <div class="btn-group justify-content-center" role="group" style="width: auto; display: inline-flex;">
          <%= link_to "Get Started", new_user_registration_path, 
              class: "btn btn-lg border border-white", 
              style: "background-color: var(--bs-danger-bg-subtle); transition: background-color 0.3s, color 0.3s;" %>
          <%= link_to "Log In", new_user_session_path, 
              class: "btn btn-lg border border-white", 
              style: "background-color: var(--bs-danger-bg-subtle); transition: background-color 0.3s, color 0.3s;" %>
        </div>
      </div>
      <style>
        .btn:hover {
          background-color: var(--bs-danger);
          color: white;
        }
      </style>
    </div>
    
    <div class="card-footer bg-dark-subtle text-secondary text-center">
      <span class="text-muted" style="font-size: 0.8rem;">
        This tool is built as part of a StartSchool assignment and is completely free to use.
      </span>
    </div>
  </div>
</div>

