<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td>
          <% if user.admin? %>
            <%= link_to 'Demote to User', remove_admin_user_path(user), method: :patch %>
          <% else %>
            <%= link_to 'Promote to Admin', make_admin_user_path(user), method: :patch %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>