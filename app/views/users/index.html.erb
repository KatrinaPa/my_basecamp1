<h1 class="my-3">Users</h1>
<div class="table-responsive container-sm">
  <table class="table table-striped table-bordered">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.role %></td>
          <td>
          <% if user.admin? %>
            <%= link_to 'Demote to User', remove_admin_user_path(user), method: :patch, class: 'btn btn-sm w-100', style: 'background-color: var(--bs-success-bg-subtle);' %>
          <% else %>
            <%= link_to 'Promote to Admin', make_admin_user_path(user), method: :patch, class: 'btn btn-sm w-100', style: 'background-color: var(--bs-danger-bg-subtle);' %>
          <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>