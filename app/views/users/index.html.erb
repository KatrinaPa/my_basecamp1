<h1 class="my-3">Users</h1>
<div class="table-responsive container-sm">
  <table class="table table-striped table-bordered">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Role Actions</th>
        <% if current_user&.admin? %>
          <th>Admin Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.role %></td>
          <td>
            <% if user.admin? %>
              <%= button_to 'Demote to User', remove_admin_user_path(user), method: :patch, 
                  class: 'btn btn-sm w-100', 
                  style: 'background-color: var(--bs-success-bg-subtle);' %>
            <% else %>
              <%= button_to 'Promote to Admin', make_admin_user_path(user), method: :patch, 
                  class: 'btn btn-sm w-100', 
                  style: 'background-color: var(--bs-danger-bg-subtle);' %>
            <% end %>
          </td>
          <% if current_user&.admin? && current_user != user %>
            <td class="d-flex gap-2 justify-content-center">
              <%= link_to edit_user_path(user), class: "btn btn-sm btn-outline-secondary" do %>
                <i class="bi bi-pencil"></i> Edit
              <% end %>
              <%= button_to user_path(user), method: :delete, 
                  class: "btn btn-sm btn-outline-secondary",
                  data: { confirm: "Are you sure you want to delete this user? This action cannot be undone." } do %>
                <i class="bi bi-trash"></i> Delete
              <% end %>
            </td>
          <% elsif current_user&.admin? %>
            <td class="text-center">
              <span class="text-muted">Current User</span>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>