<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-header border-0" style="background-color: var(--bs-success-bg-subtle);">
          <h2 class="card-title mb-0">Edit User</h2>
        </div>

        <div class="card-body">
          <%= form_with(model: @user, local: true) do |f| %>
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control" %>
            </div>

            <div class="actions">
              <%= f.submit "Update User", class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>

        <div class="card-footer border-0 bg-light">
          <div class="d-flex gap-2">
            <%= link_to "Back to users", users_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div> 